{
  "manifest_version": 3,
  "name": "SaveSift — LinkedIn Capture",
  "version": "0.3.0",
  "description": "Fetch visible LinkedIn post text on explicit request from SaveSift. Session cookies remain in the browser.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://save-sift.onrender.com/*",
      "https://saved-posts-lab-nithin.tanglednoodles.chatgpt.site/*",
      "http://localhost:8000/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://save-sift.onrender.com/*",
        "https://saved-posts-lab-nithin.tanglednoodles.chatgpt.site/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
