{
  "manifest_version": 3,
  "name": "SaveSift \u2014 LinkedIn Capture",
  "version": "0.2.0",
  "description": "Fetch visible LinkedIn post text on explicit request from SaveSift. Session cookies remain in the browser.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://save-sift.onrender.com/*",
      "https://saved-posts-lab-nithin.tanglednoodles.chatgpt.site/*",
      "http://localhost:8000/*"
    ]
  }
}
